# General
ENV=development
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=bis_user
POSTGRES_PASSWORD=bis_secure_password
POSTGRES_DB=bis_regulatory_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=bis_standards_index

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=bis_chunks_collection

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bis_neo4j_password

# IndicBERT & HuggingFace
INDICBERT_MODEL_NAME=ai4bharat/indic-bert

# Ollama LLM
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
